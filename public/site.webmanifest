{
  "name": "Draftside",
  "short_name": "Draftside",
  "description": "A private offline writing editor powered by TipTap and Chrome built-in Gemini Nano.",
  "start_url": "/write",
  "scope": "/",
  "icons": [
    { "src": "draftside.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "draftside-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "draftside-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "draftside-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "categories": ["productivity", "utilities"],
  "prefer_related_applications": false,
  "related_applications": [
    { "platform": "webapp", "url": "https://draftside.ai/site.webmanifest" }
  ],
  "shortcuts": [
    {
      "name": "Open editor",
      "short_name": "Editor",
      "url": "/write",
      "icons": [{ "src": "draftside-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
