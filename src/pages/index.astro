---
import { Font } from "astro:assets";
import PwaRegistration from "../components/PwaRegistration.astro";
import {
  authorName,
  defaultSiteUrl,
  description,
  ogImageAlt,
  ogImagePath,
  siteName,
  title,
  xHandle,
} from "../site-meta.js";
import "../styles/global.css";
import "../styles/landing.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? defaultSiteUrl;
const pageUrl = `${siteUrl}/`;
const metaImage = `${siteUrl}${ogImagePath}`;
const xUrl = "https://x.com/colinarms";
const robotsContent = "index, follow, max-image-preview:large, max-snippet:-1";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en-US",
    publisher: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: siteName,
    url: pageUrl,
    description,
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Any modern Chrome browser",
    browserRequirements: "Chrome with built-in AI availability for local Gemini Nano features",
    image: metaImage,
    isAccessibleForFree: true,
    author: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
    featureList: [
      "Open source",
      "Runs 100% offline in the browser",
      "On-device Chrome built-in Gemini Nano",
      "Ghost sentence completions accepted with Tab",
      "Inline alternate wording suggestions",
      "Draft classification: form, intent, stance, friction, next move",
      "Private Vault: passkey-encrypted drafts via WebAuthn PRF",
      "Persistent local drafts in browser storage",
      "Installable as a progressive web app",
    ],
    keywords: "open source writing editor, offline AI writing, local-first writing app, Gemini Nano writing tool, Chrome built-in AI editor, on-device AI writing, private drafting tool, passkey encrypted notes, WebAuthn PRF vault",
  },
]);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/localwrite.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/localwrite-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <script type="application/ld+json" set:html={structuredData}></script>
    <PwaRegistration />

    <script is:inline>
      const root = document.documentElement;
      const darkModeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const THEME_KEY = "draftside.theme";
      const THEME_TRANSITION_MS = 240;
      let themeTransitionTimeout;

      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        root.classList.add("motion-pending");
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            root.classList.remove("motion-pending");
            root.classList.add("motion-ready");
          });
        });
      }

      updateMode();
      darkModeMediaQuery.addEventListener("change", () => {
        if (localStorage.getItem(THEME_KEY)) return;
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      });

      function updateMode() {
        const saved = localStorage.getItem(THEME_KEY);
        const isDark = saved === "dark" || (!saved && darkModeMediaQuery.matches);
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      }

      function startThemeTransition() {
        root.classList.add("theme-switching");
        window.clearTimeout(themeTransitionTimeout);
        themeTransitionTimeout = window.setTimeout(() => {
          root.classList.remove("theme-switching");
        }, THEME_TRANSITION_MS);
      }

      window.toggleDarkMode = function () {
        const isDark = root.classList.contains("dark");
        localStorage.setItem(THEME_KEY, isDark ? "light" : "dark");
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      };
    </script>

    <script is:inline>
      (function () {
        function init() {
          const nav = document.querySelector("[data-landing-nav]");
          if (!nav) return;

          let lastY = window.scrollY;
          let offset = 0;
          let navHeight = nav.offsetHeight;
          let ticking = false;

          window.addEventListener("resize", function () {
            navHeight = nav.offsetHeight;
          });

          function update() {
            const y = window.scrollY;
            const delta = y - lastY;
            lastY = y;

            if (y <= 0) {
              offset = 0;
            } else {
              offset = Math.min(0, Math.max(-navHeight, offset - delta));
            }

            nav.style.transform = "translateY(" + offset + "px)";
            nav.classList.toggle("is-scrolled", y > 0);
            ticking = false;
          }

          window.addEventListener("scroll", function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

    <script is:inline>
      (function () {
        function init() {
        const ill = document.querySelector("[data-illustration]");
        if (!ill) return;

        const body = ill.querySelector("[data-illustration-body]");
        const panel = ill.querySelector("[data-illustration-panel]");
        const buttons = Array.from(ill.querySelectorAll("[data-action]"));
        if (!body || !panel || buttons.length === 0) return;

        const TITLE = "Notes toward the thing I mean";

        const STATES = {
          continue: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence<span class=\"ghost-text\"> and offers the next few words.</span><span class=\"ghost-key\">tab</span></p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">on-device model</div>" +
              "<div class=\"status-row\"><span class=\"status-dot\"></span><span>Gemini Nano &middot; ready</span></div></div>",
          },
          rewrite: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. <span class=\"rewrite-old\">Draftside keeps the page quiet</span> <span class=\"rewrite-new\">the page stays still</span> while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">alternate phrasing</div>" +
              "<ul class=\"alt-list\">" +
              "<li>tighten the page</li>" +
              "<li class=\"active\">the page stays still</li>" +
              "<li>silence the page</li>" +
              "</ul></div>",
          },
          classify: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence and offers the next few words.</p>",
            panel:
              "<div class=\"classification\">" +
              "<div class=\"panel-title\" style=\"margin-bottom:0.55rem\">signals</div>" +
              "<dl>" +
              "<dt>form</dt><dd>notes</dd>" +
              "<dt>intent</dt><dd>drafting</dd>" +
              "<dt>stance</dt><dd>tentative</dd>" +
              "<dt>friction</dt><dd>finding the thread</dd>" +
              "</dl></div>",
          },
          translate: {
            body:
              "<strong>Notas hacia lo que quiero decir</strong>" +
              "<p>Empieza con la versión áspera. Draftside mantiene la página en silencio mientras la IA local espera al borde de la frase y ofrece las siguientes palabras.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">translate</div>" +
              "<div class=\"lang-row\"><span class=\"lang-pill\">EN</span><span class=\"lang-arrow\">→</span><span class=\"lang-pill\">ES</span></div></div>",
          },
          chat: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start rough. The page stays quiet while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">local chat</div>" +
              "<div class=\"chat-thread\">" +
              "<div class=\"chat-row is-user\">make the opening sharper</div>" +
              "<div class=\"chat-row is-assistant\">tightened the first line and dropped the qualifier.</div>" +
              "</div></div>",
          },
          transcribe: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence.<span class=\"transcribe-incoming\"> And one more thing &mdash; this part I'm saying out loud.</span></p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">voice note</div>" +
              "<div class=\"rec-row\"><span class=\"rec-dot\"></span><span>00:14 &middot; listening</span>" +
              "<span class=\"rec-bars\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span><span></span></span>" +
              "</div></div>",
          },
        };

        const order = ["continue", "rewrite", "classify", "translate", "chat", "transcribe"];
        const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let active = "continue";
        let userInteracted = false;
        let hovered = false;
        let visible = true;
        let timer = null;

        function setActiveButton(key) {
          buttons.forEach(function (btn) {
            const isActive = btn.dataset.action === key;
            btn.classList.toggle("active", isActive);
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        }

        function render(key, animate) {
          const state = STATES[key];
          if (!state) return;
          active = key;
          setActiveButton(key);

          if (!animate) {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            return;
          }

          body.classList.add("is-fading");
          panel.classList.add("is-fading");
          window.setTimeout(function () {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            window.requestAnimationFrame(function () {
              body.classList.remove("is-fading");
              panel.classList.remove("is-fading");
            });
          }, 180);
        }

        function tick() {
          if (userInteracted || hovered || !visible) return;
          const idx = order.indexOf(active);
          const next = order[(idx + 1) % order.length];
          render(next, true);
        }

        function startCycle() {
          if (reduceMotion || userInteracted) return;
          stopCycle();
          timer = window.setInterval(tick, 3500);
        }

        function stopCycle() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            userInteracted = true;
            stopCycle();
            render(btn.dataset.action, true);
          });
        });

        ill.addEventListener("mouseenter", function () { hovered = true; });
        ill.addEventListener("mouseleave", function () { hovered = false; });
        ill.addEventListener("focusin", function () { hovered = true; });
        ill.addEventListener("focusout", function () { hovered = false; });

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              visible = entry.isIntersecting;
            });
          }, { threshold: 0.15 });
          observer.observe(ill);
        }

        render("continue", false);
        startCycle();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

  </head>
  <body class="overflow-x-hidden bg-white text-zinc-900 antialiased dark:bg-[#141414] dark:text-zinc-100">
    <div class="page-shell">
      <nav data-landing-nav class="sticky top-0 z-20 px-6 backdrop-blur-md bg-white/80 dark:bg-[#141414]/80 will-change-transform">
