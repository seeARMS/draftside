---
import { Font } from "astro:assets";
import PwaRegistration from "../components/PwaRegistration.astro";
import {
  authorName,
  defaultSiteUrl,
  description,
  ogImageAlt,
  ogImagePath,
  siteName,
  title,
  xHandle,
} from "../site-meta.js";
import "../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? defaultSiteUrl;
const pageUrl = `${siteUrl}/`;
const metaImage = `${siteUrl}${ogImagePath}`;
const xUrl = "https://x.com/colinarms";
const robotsContent = "index, follow, max-image-preview:large, max-snippet:-1";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en-US",
    publisher: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: siteName,
    url: pageUrl,
    description,
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Any modern Chrome browser",
    browserRequirements: "Chrome with built-in AI availability for local Gemini Nano features",
    image: metaImage,
    isAccessibleForFree: true,
    author: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
    featureList: [
      "Full-screen TipTap writing editor",
      "Offline draft persistence",
      "Chrome built-in Gemini Nano assistance",
      "Inline alternate wording suggestions",
      "Ghost sentence completions accepted with Tab",
      "Installable progressive web app",
    ],
    keywords: "offline writing editor, local AI writing, Gemini Nano, TipTap editor, private drafting app",
  },
]);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/localwrite.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/localwrite-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <script type="application/ld+json" set:html={structuredData}></script>
    <PwaRegistration />

    <script is:inline>
      const root = document.documentElement;
      const darkModeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const THEME_KEY = "draftside.theme";
      const THEME_TRANSITION_MS = 240;
      let themeTransitionTimeout;

      updateMode();
      darkModeMediaQuery.addEventListener("change", () => {
        if (localStorage.getItem(THEME_KEY)) return;
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      });

      function updateMode() {
        const saved = localStorage.getItem(THEME_KEY);
        const isDark = saved === "dark" || (!saved && darkModeMediaQuery.matches);
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      }

      function startThemeTransition() {
        root.classList.add("theme-switching");
        window.clearTimeout(themeTransitionTimeout);
        themeTransitionTimeout = window.setTimeout(() => {
          root.classList.remove("theme-switching");
        }, THEME_TRANSITION_MS);
      }

      window.toggleDarkMode = function () {
        const isDark = root.classList.contains("dark");
        localStorage.setItem(THEME_KEY, isDark ? "light" : "dark");
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      };
    </script>

    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      :root {
        font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      }

      .theme-switching,
      .theme-switching *,
      .theme-switching *::before,
      .theme-switching *::after {
        transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform !important;
        transition-duration: 240ms !important;
        transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      .page-shell {
        min-height: 100svh;
        background:
          linear-gradient(180deg, rgba(250, 250, 250, 0.96), rgba(255, 255, 255, 1) 42%),
          repeating-linear-gradient(90deg, rgba(24, 24, 27, 0.04) 0, rgba(24, 24, 27, 0.04) 1px, transparent 1px, transparent 64px);
      }

      .dark .page-shell {
        background:
          linear-gradient(180deg, rgba(10, 10, 10, 0.96), rgba(20, 20, 20, 1) 44%),
          repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.045) 0, rgba(255, 255, 255, 0.045) 1px, transparent 1px, transparent 64px);
      }

      .product-field {
        position: absolute;
        inset: 5.75rem max(-7vw, -7rem) auto auto;
        width: min(62rem, 74vw);
        height: min(35rem, 56svh);
        border: 1px solid rgba(212, 212, 216, 0.78);
        border-radius: 1.35rem;
        background: rgba(255, 255, 255, 0.82);
        box-shadow:
          0 1px 2px rgba(15, 23, 42, 0.06),
          0 28px 80px rgba(15, 23, 42, 0.12);
        overflow: hidden;
        transform: rotate(-1deg);
      }

      .dark .product-field {
        border-color: rgba(63, 63, 70, 0.9);
        background: rgba(24, 24, 27, 0.78);
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.32),
          0 30px 90px rgba(0, 0, 0, 0.42);
      }

      .product-field::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(90deg, rgba(244, 244, 245, 0.78) 0 15rem, transparent 15rem),
          linear-gradient(90deg, transparent calc(100% - 18rem), rgba(244, 244, 245, 0.78) calc(100% - 18rem));
      }

      .dark .product-field::before {
        background:
          linear-gradient(90deg, rgba(39, 39, 42, 0.84) 0 15rem, transparent 15rem),
          linear-gradient(90deg, transparent calc(100% - 18rem), rgba(39, 39, 42, 0.84) calc(100% - 18rem));
      }

      .draft-lines {
        position: absolute;
        left: 19rem;
        top: 5.5rem;
        width: min(32rem, 44%);
        color: rgba(24, 24, 27, 0.9);
        font-size: clamp(1.05rem, 1.5vw, 1.5rem);
        line-height: 1.75;
      }

      .dark .draft-lines {
        color: rgba(244, 244, 245, 0.92);
      }

      .draft-lines strong {
        display: block;
        margin-bottom: 1.2rem;
        font-size: 1.25em;
        font-weight: 600;
        letter-spacing: -0.02em;
      }

      .ghost-text {
        color: rgba(113, 113, 122, 0.72);
      }

      .side-panel {
        position: absolute;
        right: 1rem;
        top: 1rem;
        width: 15.5rem;
        display: grid;
        gap: 0.65rem;
        padding: 0.75rem;
        border-left: 1px solid rgba(228, 228, 231, 0.8);
        color: rgba(82, 82, 91, 0.95);
        font-size: 0.8rem;
      }

      .dark .side-panel {
        border-color: rgba(63, 63, 70, 0.92);
        color: rgba(212, 212, 216, 0.88);
      }

      .side-panel span {
        display: inline-flex;
        width: fit-content;
        border-radius: 0.45rem;
        background: rgba(244, 244, 245, 0.96);
        padding: 0.28rem 0.5rem;
      }

      .dark .side-panel span {
        background: rgba(63, 63, 70, 0.82);
      }

      .feature-grid > div {
        border-top: 1px solid rgba(228, 228, 231, 0.88);
        padding-top: 1.35rem;
      }

      .dark .feature-grid > div {
        border-color: rgba(63, 63, 70, 0.86);
      }

      @media (max-width: 900px) {
        .product-field {
          position: relative;
          inset: auto;
          width: 100%;
          height: 24rem;
          margin-top: 2.5rem;
          transform: none;
        }

        .product-field::before {
          background: linear-gradient(90deg, rgba(244, 244, 245, 0.78) 0 9rem, transparent 9rem);
        }

        .dark .product-field::before {
          background: linear-gradient(90deg, rgba(39, 39, 42, 0.84) 0 9rem, transparent 9rem);
        }

        .draft-lines {
          left: 2rem;
          top: 4rem;
          width: calc(100% - 4rem);
        }

        .side-panel {
          display: none;
        }
      }
    </style>
  </head>
  <body class="overflow-x-hidden bg-white text-zinc-900 antialiased dark:bg-[#141414] dark:text-zinc-100">
    <div class="page-shell">
      <nav class="relative z-20">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 text-sm">
          <a href="/" class="inline-flex items-center gap-2 font-medium text-zinc-950 transition-opacity hover:opacity-80 dark:text-zinc-50">
            <img src="/localwrite-192.png" alt="" width="28" height="28" class="size-7 rounded-md" />
            Draftside
          </a>
          <div class="flex items-center gap-5 text-zinc-500 dark:text-zinc-400">
            <a href="/editor" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Editor</a>
            <button
              type="button"
              onclick="toggleDarkMode()"
              aria-label="Toggle dark mode"
              class="relative flex h-8 w-8 items-center justify-center text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              <svg class="absolute h-4 w-4 rotate-90 scale-0 opacity-0 transition-all duration-300 dark:rotate-0 dark:scale-100 dark:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
              <svg class="absolute h-4 w-4 rotate-0 scale-100 opacity-100 transition-all duration-300 dark:rotate-90 dark:scale-0 dark:opacity-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <main>
        <section class="relative overflow-hidden px-6 pb-14 pt-14 md:min-h-[82svh] md:pb-20 md:pt-20">
          <div class="product-field" aria-hidden="true">
            <div class="draft-lines">
              <strong>Notes toward the thing I mean</strong>
              <p>
                Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence
                <span class="ghost-text">and offers the next few words.</span>
              </p>
            </div>
            <div class="side-panel">
              <span>Gemini Nano ready</span>
              <span>alternate wording</span>
              <span>offline drafts</span>
              <span>Tab to accept</span>
            </div>
          </div>

          <div class="relative z-10 mx-auto max-w-6xl">
            <div class="max-w-2xl">
              <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">Private writing, local intelligence</p>
              <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.035em] text-zinc-950 text-balance dark:text-zinc-50 sm:text-6xl md:text-7xl">
                Draftside
              </h1>
              <p class="mt-6 max-w-[38rem] text-lg leading-8 text-zinc-600 text-pretty dark:text-zinc-400">
                A minimal writing editor that helps you finish thoughts without sending your drafts to a server. It uses TipTap, offline storage, and Chrome built-in Gemini Nano for private autocomplete, rewrites, classification, and alternate phrasing.
              </p>
              <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                <a href="/editor" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200">
                  Open the editor
                </a>
                <a href="#how-it-works" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-zinc-200 px-5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-900">
                  See how it works
                </a>
              </div>
            </div>
          </div>
        </section>

        <section id="how-it-works" class="px-6 py-16 md:py-20">
          <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.85fr_1.15fr] md:items-start">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">Why it exists</p>
              <h2 class="mt-4 max-w-md text-3xl font-semibold tracking-[-0.025em] text-zinc-950 dark:text-zinc-50 md:text-4xl">
                AI help that stays beside the draft, not above it.
              </h2>
            </div>
            <div class="feature-grid grid gap-8 sm:grid-cols-2">
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Offline by default</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Drafts persist in browser storage and the app is installable as a PWA. Keep working when the network disappears.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Local Gemini Nano</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">When Chrome exposes built-in AI, Draftside runs inference on-device for sentence completion and writing assistance.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Subtle completions</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Pause for a second and Draftside suggests a faint continuation. Press Tab to accept, or keep typing to ignore it.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Language at the cursor</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Highlight a word or phrase to get alternate wording from the local model, then click once to swap it inline.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="px-6 pb-24 pt-6 md:pb-28">
          <div class="mx-auto max-w-6xl border-t border-zinc-200 pt-12 dark:border-zinc-800">
            <div class="max-w-2xl">
              <h2 class="text-3xl font-semibold tracking-[-0.025em] text-zinc-950 dark:text-zinc-50">Open a blank page with a useful edge.</h2>
              <p class="mt-4 text-lg leading-8 text-zinc-600 dark:text-zinc-400">
                Draftside is built for notes, essays, posts, and any draft that benefits from a second pass without leaving the writing flow.
              </p>
              <a href="/editor" class="mt-7 inline-flex min-h-11 items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200">
                Start drafting
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="border-t border-zinc-200 px-6 py-8 text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <span>&copy; 2026 <a href="https://armstr.ng" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Colin Armstrong</a></span>
          <div class="flex items-center gap-6">
            <a href="/editor" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Editor</a>
            <a href={xUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">@colinarms</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
