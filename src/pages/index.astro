      .rec-bars span:nth-child(5) { animation-delay: 0.6s; height: 55%; }

      @keyframes rec-pulse {
        0%, 100% { box-shadow: 0 0 0 4px rgba(239, 68, 68, 0.18); }
        50% { box-shadow: 0 0 0 7px rgba(239, 68, 68, 0.06); }
      }

      @keyframes rec-bar {
