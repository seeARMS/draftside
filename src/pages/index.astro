---
import { Font } from "astro:assets";
import Analytics from "../components/Analytics.astro";
import PwaRegistration from "../components/PwaRegistration.astro";
import {
  authorName,
  defaultSiteUrl,
  description,
  ogImageAlt,
  ogImagePath,
  siteName,
  title,
  xHandle,
} from "../site-meta.js";
import "../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? defaultSiteUrl;
const pageUrl = `${siteUrl}/`;
const sitemapUrl = `${siteUrl}/sitemap-index.xml`;
const metaImage = `${siteUrl}${ogImagePath}`;
const xUrl = "https://x.com/colinarms";
const robotsContent = "index, follow, max-image-preview:large, max-snippet:-1";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en-US",
    publisher: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: siteName,
    url: pageUrl,
    description,
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Any modern Chrome browser",
    browserRequirements: "Chrome with built-in AI availability for local Gemini Nano features",
    image: metaImage,
    isAccessibleForFree: true,
    author: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
    featureList: [
      "Open source",
      "Runs 100% offline in the browser",
      "On-device Chrome built-in Gemini Nano",
      "Ghost sentence completions accepted with Tab",
      "Inline alternate wording suggestions",
      "Draft classification: form, intent, stance, friction, next move",
      "Private Vault: passkey-encrypted drafts via WebAuthn PRF",
      "Persistent local drafts in browser storage",
      "Installable as a progressive web app",
    ],
    keywords: "open source writing editor, offline AI writing, local-first writing app, Gemini Nano writing tool, Chrome built-in AI editor, on-device AI writing, private drafting tool, passkey encrypted notes, WebAuthn PRF vault",
  },
]);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/draftside.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/draftside-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <script type="application/ld+json" set:html={structuredData}></script>
    <Analytics />
    <PwaRegistration />

    <script is:inline>
      const root = document.documentElement;
      const darkModeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const THEME_KEY = "draftside.theme";
      const THEME_TRANSITION_MS = 240;
      let themeTransitionTimeout;

      updateMode();
      darkModeMediaQuery.addEventListener("change", () => {
        if (localStorage.getItem(THEME_KEY)) return;
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      });

      function updateMode() {
        const saved = localStorage.getItem(THEME_KEY);
        const isDark = saved === "dark" || (!saved && darkModeMediaQuery.matches);
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      }

      function startThemeTransition() {
        window.clearTimeout(themeTransitionTimeout);
        themeTransitionTimeout = window.setTimeout(() => {
        }, THEME_TRANSITION_MS);
      }

      window.toggleDarkMode = function () {
        const isDark = root.classList.contains("dark");
        localStorage.setItem(THEME_KEY, isDark ? "light" : "dark");
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      };
    </script>

    <script is:inline>
      (function () {
        function init() {
          const nav = document.querySelector("[data-landing-nav]");
          if (!nav) return;

          let lastY = window.scrollY;
          let offset = 0;
          let navHeight = nav.offsetHeight;
          let ticking = false;

          window.addEventListener("resize", function () {
            navHeight = nav.offsetHeight;
          });

          function update() {
            const y = window.scrollY;
            const delta = y - lastY;
            lastY = y;

            if (y <= 0) {
              offset = 0;
            } else {
              offset = Math.min(0, Math.max(-navHeight, offset - delta));
            }

            nav.style.transform = "translateY(" + offset + "px)";
            ticking = false;
          }

          window.addEventListener("scroll", function () {
            if (!ticking) {
              window.requestAnimationFrame(update);
              ticking = true;
            }
          }, { passive: true });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

    <script is:inline>
      (function () {
        function init() {
        const ill = document.querySelector("[data-illustration]");
        if (!ill) return;

        const body = ill.querySelector("[data-illustration-body]");
        const panel = ill.querySelector("[data-illustration-panel]");
        const buttons = Array.from(ill.querySelectorAll("[data-action]"));
        if (!body || !panel || buttons.length === 0) return;

        const TITLE = "Working title";
        const DRAFT_TITLE = "mb-5 block text-[1.4em] font-semibold tracking-[-0.022em]";
        const GHOST_TEXT = "text-zinc-500/60 dark:text-zinc-400/60";
        const GHOST_KEY = "ml-[0.45em] inline-block rounded border border-b-2 border-zinc-300 bg-zinc-100 px-[0.45em] py-[0.05em] align-[0.18em] font-mono text-[0.62em] uppercase leading-snug tracking-[0.05em] text-zinc-600 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-300";
        const PANEL_BLOCK = "p-4 font-mono";
        const PANEL_TITLE = "mb-2 font-mono text-[0.6rem] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400";
        const STATUS_ROW = "flex items-center gap-2 text-[0.7rem] text-zinc-800 dark:text-zinc-200";
        const STATUS_DOT = "size-1.5 rounded-full bg-green-500 shadow-[0_0_0_3px_rgb(34_197_94/0.2)]";
        const ALT_LIST = "m-0 flex list-none flex-col gap-1 p-0";
        const ALT_ITEM = "rounded border border-zinc-200 bg-white/60 px-2 py-1 text-[0.68rem] text-zinc-600 dark:border-zinc-700 dark:bg-zinc-800/60 dark:text-zinc-300";
        const ALT_ITEM_ACTIVE = "rounded border border-green-500/45 bg-green-500/15 px-2 py-1 text-[0.68rem] text-green-800 dark:border-green-500/55 dark:bg-green-500/20 dark:text-green-100";
        const LANG_PILL = "rounded-full border border-zinc-200 bg-zinc-100/70 px-2 py-1 text-[0.62rem] uppercase tracking-[0.06em] dark:border-zinc-700 dark:bg-zinc-700/50";
        const CHAT_THREAD = "flex flex-col gap-2 text-[0.66rem] leading-normal";
        const CHAT_USER = "max-w-[92%] self-end rounded-lg bg-zinc-950 px-2.5 py-1.5 text-zinc-100 dark:bg-zinc-100 dark:text-zinc-950";
        const CHAT_ASSISTANT = "max-w-[92%] self-start rounded-lg border border-zinc-200 bg-zinc-100 px-2.5 py-1.5 text-zinc-800 dark:border-zinc-600 dark:bg-zinc-700/60 dark:text-zinc-200";
        const CLASSIFICATION = "p-4 font-mono";
        const CLASSIFICATION_DL = "m-0 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2";
        const CLASSIFICATION_DT = "text-[0.6rem] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400";
        const CLASSIFICATION_DD = "m-0 text-[0.7rem] tracking-normal text-zinc-800 dark:text-zinc-200";

        const STATES = {
          continue: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence<span class=\"" + GHOST_TEXT + "\"> and offers the next few words.</span><span class=\"" + GHOST_KEY + "\">tab</span></p>",
            panel:
              "<div class=\"" + PANEL_BLOCK + "\"><div class=\"" + PANEL_TITLE + "\">on-device model</div>" +
              "<div class=\"" + STATUS_ROW + "\"><span class=\"" + STATUS_DOT + "\"></span><span>Gemini Nano &middot; ready</span></div></div>",
          },
          rewrite: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">" + TITLE + "</strong>" +
              "<p>Start with the rough version. <span class=\"text-zinc-400 line-through decoration-red-400/60 decoration-[1.5px] dark:text-zinc-400/60\">Draftside keeps the page quiet</span> <span class=\"rounded bg-green-500/15 px-1 text-green-800 dark:bg-green-500/20 dark:text-green-100\">the page stays still</span> while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"" + PANEL_BLOCK + "\"><div class=\"" + PANEL_TITLE + "\">alternate phrasing</div>" +
              "<ul class=\"" + ALT_LIST + "\">" +
              "<li class=\"" + ALT_ITEM + "\">tighten the page</li>" +
              "<li class=\"" + ALT_ITEM_ACTIVE + "\">the page stays still</li>" +
              "<li class=\"" + ALT_ITEM + "\">silence the page</li>" +
              "</ul></div>",
          },
          classify: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence and offers the next few words.</p>",
            panel:
              "<div class=\"" + CLASSIFICATION + "\">" +
              "<div class=\"" + PANEL_TITLE + "\">signals</div>" +
              "<dl class=\"" + CLASSIFICATION_DL + "\">" +
              "<dt class=\"" + CLASSIFICATION_DT + "\">form</dt><dd class=\"" + CLASSIFICATION_DD + "\">notes</dd>" +
              "<dt class=\"" + CLASSIFICATION_DT + "\">intent</dt><dd class=\"" + CLASSIFICATION_DD + "\">drafting</dd>" +
              "<dt class=\"" + CLASSIFICATION_DT + "\">stance</dt><dd class=\"" + CLASSIFICATION_DD + "\">tentative</dd>" +
              "<dt class=\"" + CLASSIFICATION_DT + "\">friction</dt><dd class=\"" + CLASSIFICATION_DD + "\">finding the thread</dd>" +
              "</dl></div>",
          },
          translate: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">Título provisional</strong>" +
              "<p>Empieza con la versión áspera. Draftside mantiene la página en silencio mientras la IA local espera al borde de la frase y ofrece las siguientes palabras.</p>",
            panel:
              "<div class=\"" + PANEL_BLOCK + "\"><div class=\"" + PANEL_TITLE + "\">translate</div>" +
              "<div class=\"flex items-center gap-2 text-[0.7rem] text-zinc-800 dark:text-zinc-200\"><span class=\"" + LANG_PILL + "\">EN</span><span class=\"text-zinc-500 dark:text-zinc-400\">→</span><span class=\"" + LANG_PILL + "\">ES</span></div></div>",
          },
          chat: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">" + TITLE + "</strong>" +
              "<p>Start rough. The page stays quiet while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"" + PANEL_BLOCK + "\"><div class=\"" + PANEL_TITLE + "\">local chat</div>" +
              "<div class=\"" + CHAT_THREAD + "\">" +
              "<div class=\"" + CHAT_USER + "\">make the opening sharper</div>" +
              "<div class=\"" + CHAT_ASSISTANT + "\">tightened the first line and dropped the qualifier.</div>" +
              "</div></div>",
          },
          transcribe: {
            body:
              "<strong class=\"" + DRAFT_TITLE + "\">" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence.<span class=\"rounded bg-green-500/10 px-1 text-green-800 dark:bg-green-500/20 dark:text-green-100\"> And one more thing &mdash; this part I'm saying out loud.</span></p>",
            panel:
              "<div class=\"" + PANEL_BLOCK + "\"><div class=\"" + PANEL_TITLE + "\">voice note</div>" +
              "<div class=\"flex items-center gap-2 text-[0.7rem] text-zinc-800 dark:text-zinc-200\"><span class=\"size-2 rounded-full bg-red-500 shadow-[0_0_0_4px_rgb(239_68_68/0.18)] motion-safe:animate-[rec-pulse_1.6s_ease-in-out_infinite]\"></span><span>00:14 &middot; listening</span>" +
              "<span class=\"ml-auto inline-flex h-4 items-end gap-1\" aria-hidden=\"true\"><span class=\"block h-[35%] w-1 rounded-full bg-red-500/70 motion-safe:animate-[rec-bar_1.1s_ease-in-out_infinite]\"></span><span class=\"block h-[70%] w-1 rounded-full bg-red-500/70 motion-safe:animate-[rec-bar_1.1s_ease-in-out_infinite_150ms]\"></span><span class=\"block h-1/2 w-1 rounded-full bg-red-500/70 motion-safe:animate-[rec-bar_1.1s_ease-in-out_infinite_300ms]\"></span><span class=\"block h-[85%] w-1 rounded-full bg-red-500/70 motion-safe:animate-[rec-bar_1.1s_ease-in-out_infinite_450ms]\"></span><span class=\"block h-[55%] w-1 rounded-full bg-red-500/70 motion-safe:animate-[rec-bar_1.1s_ease-in-out_infinite_600ms]\"></span></span>" +
              "</div></div>",
          },
        };

        const order = ["continue", "rewrite", "classify", "translate", "chat", "transcribe"];
        const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let active = "continue";
        let userInteracted = false;
        let hovered = false;
        let visible = true;
        let timer = null;

        function setActiveButton(key) {
          buttons.forEach(function (btn) {
            const isActive = btn.dataset.action === key;
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        }

        function render(key, animate) {
          const state = STATES[key];
          if (!state) return;
          active = key;
          setActiveButton(key);

          if (!animate) {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            return;
          }

          body.classList.add("opacity-0");
          panel.classList.add("opacity-0");
          window.setTimeout(function () {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            window.requestAnimationFrame(function () {
              body.classList.remove("opacity-0");
              panel.classList.remove("opacity-0");
            });
          }, 180);
        }

        function tick() {
          if (userInteracted || hovered || !visible) return;
          const idx = order.indexOf(active);
          const next = order[(idx + 1) % order.length];
          render(next, true);
        }

        function startCycle() {
          if (reduceMotion || userInteracted) return;
          stopCycle();
          timer = window.setInterval(tick, 3500);
        }

        function stopCycle() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            userInteracted = true;
            stopCycle();
            render(btn.dataset.action, true);
          });
        });

        ill.addEventListener("mouseenter", function () { hovered = true; });
        ill.addEventListener("mouseleave", function () { hovered = false; });
        ill.addEventListener("focusin", function () { hovered = true; });
        ill.addEventListener("focusout", function () { hovered = false; });

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              visible = entry.isIntersecting;
            });
          }, { threshold: 0.15 });
          observer.observe(ill);
        }

        render("continue", false);
        startCycle();
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

  </head>
  <body class="overflow-x-hidden bg-white text-zinc-900 antialiased dark:bg-[#141414] dark:text-zinc-100">
    <div class="min-h-svh bg-[linear-gradient(180deg,rgba(250,250,250,0.96),rgba(255,255,255,1)_42%),repeating-linear-gradient(90deg,rgba(24,24,27,0.04)_0,rgba(24,24,27,0.04)_1px,transparent_1px,transparent_64px)] dark:bg-[linear-gradient(180deg,rgba(10,10,10,0.96),rgba(20,20,20,1)_44%),repeating-linear-gradient(90deg,rgba(255,255,255,0.045)_0,rgba(255,255,255,0.045)_1px,transparent_1px,transparent_64px)]">
      <nav data-landing-nav class="sticky top-0 z-20 border-b border-zinc-200/70 bg-white/80 px-6 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_8px_24px_rgba(15,23,42,0.05)] backdrop-blur-md will-change-transform dark:border-zinc-700/70 dark:bg-[#141414]/80 dark:shadow-[0_1px_2px_rgba(0,0,0,0.3),0_8px_24px_rgba(0,0,0,0.25)]">
        <div class="mx-auto flex max-w-6xl items-center justify-between py-4 text-sm">
          <a href="/" class="inline-flex items-center gap-2 font-medium text-zinc-950 transition-opacity hover:opacity-80 dark:text-zinc-50">
            <img src="/draftside-192.png" alt="" width="28" height="28" class="size-7 rounded-md" />
            Draftside
          </a>
          <div class="flex items-center gap-4 text-zinc-500 dark:text-zinc-400 sm:gap-5">
            <a href="/write" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Write</a>
            <a href="https://github.com/seeARMS/draftside" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">GitHub</a>
            <button
              type="button"
              onclick="toggleDarkMode()"
              aria-label="Toggle dark mode"
              class="relative flex h-8 w-8 items-center justify-center text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              <svg class="absolute h-4 w-4 rotate-90 scale-0 opacity-0 transition-all duration-300 dark:rotate-0 dark:scale-100 dark:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
              <svg class="absolute h-4 w-4 rotate-0 scale-100 opacity-100 transition-all duration-300 dark:rotate-90 dark:scale-0 dark:opacity-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <main>
        <section class="relative overflow-hidden px-6 pb-14 pt-12 sm:pt-14 md:pb-20 md:pt-20 xl:min-h-[82svh]">
          <div class="relative z-10 mx-auto grid max-w-6xl items-center gap-10 xl:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] xl:gap-6">
            <div class="max-w-2xl">
              <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">Open source · 100% offline · Local AI</p>
              <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.035em] text-zinc-950 text-balance dark:text-zinc-50 sm:text-6xl md:text-7xl">
                Draftside
              </h1>
              <p class="mt-6 max-w-[38rem] text-base leading-7 text-zinc-600 text-pretty dark:text-zinc-400 sm:text-lg sm:leading-8">
                An open source writing editor that runs entirely in your browser. Chrome's built-in Gemini Nano powers inline completions, rewrites, alternate phrasing, translation, and draft classification &mdash; all on your device.
              </p>
              <div class="mt-8 flex flex-col gap-3 sm:mt-9 sm:flex-row">
                <a href="/write" class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200 sm:w-auto">
                  Start writing
                </a>
                <a href="https://github.com/seeARMS/draftside" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-lg border border-zinc-200 px-5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-900 sm:w-auto">
                  <svg viewBox="0 0 24 24" class="h-4 w-4 opacity-80" fill="currentColor" aria-hidden="true">
                    <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.55v-1.92c-3.2.7-3.87-1.54-3.87-1.54-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.69 1.25 3.34.96.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.17.92-.26 1.9-.39 2.88-.39s1.96.13 2.88.39c2.19-1.48 3.15-1.17 3.15-1.17.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.4-2.7 5.37-5.27 5.65.41.36.78 1.06.78 2.13v3.16c0 .31.21.66.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z" />
                  </svg>
                  View on GitHub
                </a>
              </div>
              <p class="mt-4 text-sm text-zinc-500 dark:text-zinc-500">
                No account. No API key. No backend AI. 100% free &amp; open source.
              </p>
            </div>

