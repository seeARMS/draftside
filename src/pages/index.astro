---
import { Font } from "astro:assets";
import PwaRegistration from "../components/PwaRegistration.astro";
import {
  authorName,
  defaultSiteUrl,
  description,
  ogImageAlt,
  ogImagePath,
  siteName,
  title,
  xHandle,
} from "../site-meta.js";
import "../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? defaultSiteUrl;
const pageUrl = `${siteUrl}/`;
const metaImage = `${siteUrl}${ogImagePath}`;
const xUrl = "https://x.com/colinarms";
const robotsContent = "index, follow, max-image-preview:large, max-snippet:-1";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en-US",
    publisher: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: siteName,
    url: pageUrl,
    description,
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Any modern Chrome browser",
    browserRequirements: "Chrome with built-in AI availability for local Gemini Nano features",
    image: metaImage,
    isAccessibleForFree: true,
    author: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
    featureList: [
      "Open source",
      "Runs 100% offline in the browser",
      "On-device Chrome built-in Gemini Nano",
      "Ghost sentence completions accepted with Tab",
      "Inline alternate wording suggestions",
      "Draft classification: form, intent, stance, friction, next move",
      "Private Vault: passkey-encrypted drafts via WebAuthn PRF",
      "Persistent local drafts in browser storage",
      "Installable as a progressive web app",
    ],
    keywords: "open source writing editor, offline AI writing, local-first writing app, Gemini Nano writing tool, Chrome built-in AI editor, on-device AI writing, private drafting tool, passkey encrypted notes, WebAuthn PRF vault",
  },
]);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/localwrite.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/localwrite-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <script type="application/ld+json" set:html={structuredData}></script>
    <PwaRegistration />

    <script is:inline>
      const root = document.documentElement;
      const darkModeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const THEME_KEY = "draftside.theme";
      const THEME_TRANSITION_MS = 240;
      let themeTransitionTimeout;

      if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        root.classList.add("motion-pending");
        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            root.classList.remove("motion-pending");
            root.classList.add("motion-ready");
          });
        });
      }

      updateMode();
      darkModeMediaQuery.addEventListener("change", () => {
        if (localStorage.getItem(THEME_KEY)) return;
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      });

      function updateMode() {
        const saved = localStorage.getItem(THEME_KEY);
        const isDark = saved === "dark" || (!saved && darkModeMediaQuery.matches);
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      }

      function startThemeTransition() {
        root.classList.add("theme-switching");
        window.clearTimeout(themeTransitionTimeout);
        themeTransitionTimeout = window.setTimeout(() => {
          root.classList.remove("theme-switching");
        }, THEME_TRANSITION_MS);
      }

      window.toggleDarkMode = function () {
        const isDark = root.classList.contains("dark");
        localStorage.setItem(THEME_KEY, isDark ? "light" : "dark");
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      };
    </script>

    <script is:inline>
      (function () {
        const ill = document.querySelector("[data-illustration]");
        if (!ill) return;

        const body = ill.querySelector("[data-illustration-body]");
        const panel = ill.querySelector("[data-illustration-panel]");
        const buttons = Array.from(ill.querySelectorAll("[data-action]"));
        if (!body || !panel || buttons.length === 0) return;

        const TITLE = "Notes toward the thing I mean";

        const STATES = {
          continue: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence<span class=\"ghost-text\"> and offers the next few words.</span><span class=\"ghost-key\">tab</span></p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">on-device model</div>" +
              "<div class=\"status-row\"><span class=\"status-dot\"></span><span>Gemini Nano &middot; ready</span></div></div>",
          },
          rewrite: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. <span class=\"rewrite-old\">Draftside keeps the page quiet</span> <span class=\"rewrite-new\">the page stays still</span> while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">alternate phrasing</div>" +
              "<ul class=\"alt-list\">" +
              "<li>tighten the page</li>" +
              "<li class=\"active\">the page stays still</li>" +
              "<li>silence the page</li>" +
              "</ul></div>",
          },
          classify: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence and offers the next few words.</p>",
            panel:
              "<div class=\"classification\">" +
              "<div class=\"panel-title\" style=\"margin-bottom:0.55rem\">signals</div>" +
              "<dl>" +
              "<dt>form</dt><dd>notes</dd>" +
              "<dt>intent</dt><dd>drafting</dd>" +
              "<dt>stance</dt><dd>tentative</dd>" +
              "<dt>friction</dt><dd>finding the thread</dd>" +
              "</dl></div>",
          },
          translate: {
            body:
              "<strong>Notas hacia lo que quiero decir</strong>" +
              "<p>Empieza con la versión áspera. Draftside mantiene la página en silencio mientras la IA local espera al borde de la frase y ofrece las siguientes palabras.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">translate</div>" +
              "<div class=\"lang-row\"><span class=\"lang-pill\">EN</span><span class=\"lang-arrow\">→</span><span class=\"lang-pill\">ES</span></div></div>",
          },
          chat: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start rough. The page stays quiet while local AI waits at the edge of the sentence.</p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">local chat</div>" +
              "<div class=\"chat-thread\">" +
              "<div class=\"chat-row is-user\">make the opening sharper</div>" +
              "<div class=\"chat-row is-assistant\">tightened the first line and dropped the qualifier.</div>" +
              "</div></div>",
          },
          transcribe: {
            body:
              "<strong>" + TITLE + "</strong>" +
              "<p>Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence.<span class=\"transcribe-incoming\"> And one more thing &mdash; this part I'm saying out loud.</span></p>",
            panel:
              "<div class=\"panel-block\"><div class=\"panel-title\">voice note</div>" +
              "<div class=\"rec-row\"><span class=\"rec-dot\"></span><span>00:14 &middot; listening</span>" +
              "<span class=\"rec-bars\" aria-hidden=\"true\"><span></span><span></span><span></span><span></span><span></span></span>" +
              "</div></div>",
          },
        };

        const order = ["continue", "rewrite", "classify", "translate", "chat", "transcribe"];
        const reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        let active = "continue";
        let userInteracted = false;
        let hovered = false;
        let visible = true;
        let timer = null;

        function setActiveButton(key) {
          buttons.forEach(function (btn) {
            const isActive = btn.dataset.action === key;
            btn.classList.toggle("active", isActive);
            btn.setAttribute("aria-pressed", isActive ? "true" : "false");
          });
        }

        function render(key, animate) {
          const state = STATES[key];
          if (!state) return;
          active = key;
          setActiveButton(key);

          if (!animate) {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            return;
          }

          body.classList.add("is-fading");
          panel.classList.add("is-fading");
          window.setTimeout(function () {
            body.innerHTML = state.body;
            panel.innerHTML = state.panel;
            window.requestAnimationFrame(function () {
              body.classList.remove("is-fading");
              panel.classList.remove("is-fading");
            });
          }, 180);
        }

        function tick() {
          if (userInteracted || hovered || !visible) return;
          const idx = order.indexOf(active);
          const next = order[(idx + 1) % order.length];
          render(next, true);
        }

        function startCycle() {
          if (reduceMotion || userInteracted) return;
          stopCycle();
          timer = window.setInterval(tick, 3500);
        }

        function stopCycle() {
          if (timer !== null) {
            window.clearInterval(timer);
            timer = null;
          }
        }

        buttons.forEach(function (btn) {
          btn.addEventListener("click", function () {
            userInteracted = true;
            stopCycle();
            render(btn.dataset.action, true);
          });
        });

        ill.addEventListener("mouseenter", function () { hovered = true; });
        ill.addEventListener("mouseleave", function () { hovered = false; });
        ill.addEventListener("focusin", function () { hovered = true; });
        ill.addEventListener("focusout", function () { hovered = false; });

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              visible = entry.isIntersecting;
            });
          }, { threshold: 0.15 });
          observer.observe(ill);
        }

        render("continue", false);
        startCycle();
      })();
    </script>

    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      :root {
        font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      }

      .theme-switching,
      .theme-switching *,
      .theme-switching *::before,
      .theme-switching *::after {
        transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform !important;
        transition-duration: 240ms !important;
        transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      .page-shell {
        min-height: 100svh;
        background:
          linear-gradient(180deg, rgba(250, 250, 250, 0.96), rgba(255, 255, 255, 1) 42%),
          repeating-linear-gradient(90deg, rgba(24, 24, 27, 0.04) 0, rgba(24, 24, 27, 0.04) 1px, transparent 1px, transparent 64px);
      }

      .dark .page-shell {
        background:
          linear-gradient(180deg, rgba(10, 10, 10, 0.96), rgba(20, 20, 20, 1) 44%),
          repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.045) 0, rgba(255, 255, 255, 0.045) 1px, transparent 1px, transparent 64px);
      }

      .product-field {
        position: relative;
        height: min(36rem, 60svh);
        display: flex;
        flex-direction: column;
        border: 1px solid rgba(212, 212, 216, 0.78);
        border-radius: 0.85rem;
        background: rgba(255, 255, 255, 0.96);
        box-shadow:
          0 1px 2px rgba(15, 23, 42, 0.05),
          0 30px 80px rgba(15, 23, 42, 0.10);
        overflow: hidden;
      }

      .dark .product-field {
        border-color: rgba(63, 63, 70, 0.9);
        background: rgba(24, 24, 27, 0.92);
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.32),
          0 30px 90px rgba(0, 0, 0, 0.42);
      }

      .editor-chrome {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        gap: 0.7rem;
        height: 2.35rem;
        padding: 0 1rem;
        border-bottom: 1px solid rgba(228, 228, 231, 0.78);
        font-family: var(--font-geist-mono);
        font-size: 0.7rem;
        color: rgba(113, 113, 122, 0.95);
      }

      .editor-body {
        flex: 1;
        display: flex;
        min-height: 0;
      }

      .dark .editor-chrome {
        border-color: rgba(63, 63, 70, 0.9);
        color: rgba(161, 161, 170, 0.92);
      }

      .editor-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
      }

      .editor-filename {
        flex: 1;
        letter-spacing: -0.005em;
      }

      .editor-badge {
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        background: rgba(244, 244, 245, 0.95);
        color: rgba(82, 82, 91, 0.95);
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .dark .editor-badge {
        background: rgba(63, 63, 70, 0.7);
        color: rgba(212, 212, 216, 0.92);
      }

      .draft-body {
        flex: 1;
        padding: 2.75rem 3rem 2rem;
        color: rgba(24, 24, 27, 0.92);
        font-size: clamp(0.98rem, 1.2vw, 1.15rem);
        line-height: 1.85;
        overflow: hidden;
      }

      .dark .draft-body {
        color: rgba(244, 244, 245, 0.92);
      }

      .draft-body strong {
        display: block;
        margin-bottom: 1.35rem;
        font-size: 1.4em;
        font-weight: 600;
        letter-spacing: -0.022em;
      }

      .ghost-text {
        color: rgba(113, 113, 122, 0.6);
      }

      .dark .ghost-text {
        color: rgba(161, 161, 170, 0.55);
      }

      .ghost-key {
        display: inline-block;
        margin-left: 0.45em;
        padding: 0.05em 0.45em;
        border: 1px solid rgba(212, 212, 216, 0.85);
        border-bottom-width: 2px;
        border-radius: 0.3rem;
        background: rgba(244, 244, 245, 0.9);
        color: rgba(82, 82, 91, 0.92);
        font-family: var(--font-geist-mono);
        font-size: 0.62em;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        vertical-align: 0.18em;
        line-height: 1.4;
      }

      .dark .ghost-key {
        border-color: rgba(82, 82, 91, 0.9);
        background: rgba(39, 39, 42, 0.95);
        color: rgba(212, 212, 216, 0.85);
      }

      .ai-inspector {
        flex-shrink: 0;
        width: 16.5rem;
        display: flex;
        flex-direction: column;
        border-left: 1px solid rgba(228, 228, 231, 0.78);
        background: rgba(250, 250, 251, 0.65);
      }

      .dark .ai-inspector {
        border-color: rgba(63, 63, 70, 0.9);
        background: rgba(39, 39, 42, 0.45);
      }

      .ai-actions {
        list-style: none;
        margin: 0;
        padding: 0.9rem 0.55rem;
        border-bottom: 1px solid rgba(228, 228, 231, 0.78);
        font-family: var(--font-geist-mono);
        font-size: 0.72rem;
      }

      .dark .ai-actions {
        border-color: rgba(63, 63, 70, 0.9);
      }

      .ai-actions li {
        list-style: none;
      }

      .ai-actions button {
        position: relative;
        display: block;
        width: 100%;
        padding: 0.38rem 0.7rem;
        border-radius: 0.35rem;
        background: transparent;
        border: 0;
        color: rgba(113, 113, 122, 0.92);
        letter-spacing: -0.005em;
        font: inherit;
        text-align: left;
        cursor: pointer;
        transition: background-color 160ms ease, color 160ms ease;
      }

      .ai-actions button:hover {
        background: rgba(244, 244, 245, 0.7);
        color: rgba(24, 24, 27, 0.95);
      }

      .ai-actions button:focus-visible {
        outline: 2px solid rgba(34, 197, 94, 0.55);
        outline-offset: 1px;
      }

      .dark .ai-actions button {
        color: rgba(161, 161, 170, 0.9);
      }

      .dark .ai-actions button:hover {
        background: rgba(63, 63, 70, 0.55);
        color: rgba(244, 244, 245, 0.96);
      }

      .ai-actions button.active {
        background: rgba(244, 244, 245, 0.96);
        color: rgba(24, 24, 27, 0.95);
        font-weight: 500;
      }

      .ai-actions button.active::after {
        content: "";
        position: absolute;
        right: 0.7rem;
        top: 50%;
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: #22c55e;
        transform: translateY(-50%);
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
      }

      .dark .ai-actions button.active {
        background: rgba(63, 63, 70, 0.7);
        color: rgba(244, 244, 245, 0.96);
      }

      .draft-body,
      .inspector-panel {
        transition: opacity 200ms ease;
      }

      .draft-body.is-fading,
      .inspector-panel.is-fading {
        opacity: 0;
      }

      .rewrite-old {
        position: relative;
        color: rgba(161, 161, 170, 0.85);
        text-decoration: line-through;
        text-decoration-color: rgba(248, 113, 113, 0.55);
        text-decoration-thickness: 1.5px;
      }

      .dark .rewrite-old {
        color: rgba(161, 161, 170, 0.6);
      }

      .rewrite-new {
        background: rgba(34, 197, 94, 0.16);
        border-radius: 0.25rem;
        padding: 0 0.28em;
        color: rgba(22, 101, 52, 0.96);
      }

      .dark .rewrite-new {
        background: rgba(34, 197, 94, 0.22);
        color: rgba(187, 247, 208, 0.95);
      }

      .transcribe-incoming {
        color: rgba(22, 101, 52, 0.9);
        background: rgba(34, 197, 94, 0.1);
        padding: 0 0.2em;
        border-radius: 0.2rem;
      }

      .dark .transcribe-incoming {
        color: rgba(187, 247, 208, 0.95);
        background: rgba(34, 197, 94, 0.16);
      }

      .panel-block {
        padding: 1rem 1.15rem 1.1rem;
        font-family: var(--font-geist-mono);
      }

      .panel-title {
        color: rgba(113, 113, 122, 0.95);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.6rem;
        margin-bottom: 0.6rem;
      }

      .dark .panel-title {
        color: rgba(161, 161, 170, 0.85);
      }

      .status-row {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 0.7rem;
        color: rgba(39, 39, 46, 0.94);
      }

      .dark .status-row {
        color: rgba(228, 228, 231, 0.92);
      }

      .status-row .status-dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
      }

      .alt-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.32rem;
      }

      .alt-list li {
        padding: 0.32rem 0.55rem;
        border-radius: 0.3rem;
        border: 1px solid rgba(228, 228, 231, 0.85);
        font-size: 0.68rem;
        color: rgba(82, 82, 91, 0.96);
        background: rgba(255, 255, 255, 0.6);
      }

      .alt-list li.active {
        background: rgba(34, 197, 94, 0.14);
        border-color: rgba(34, 197, 94, 0.45);
        color: rgba(22, 101, 52, 0.96);
      }

      .dark .alt-list li {
        border-color: rgba(63, 63, 70, 0.86);
        background: rgba(39, 39, 42, 0.6);
        color: rgba(212, 212, 216, 0.92);
      }

      .dark .alt-list li.active {
        background: rgba(34, 197, 94, 0.2);
        border-color: rgba(34, 197, 94, 0.55);
        color: rgba(187, 247, 208, 0.95);
      }

      .lang-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.7rem;
        color: rgba(39, 39, 46, 0.94);
      }

      .lang-pill {
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        border: 1px solid rgba(228, 228, 231, 0.85);
        background: rgba(244, 244, 245, 0.7);
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .lang-arrow {
        color: rgba(113, 113, 122, 0.92);
      }

      .dark .lang-row {
        color: rgba(228, 228, 231, 0.92);
      }

      .dark .lang-pill {
        border-color: rgba(63, 63, 70, 0.86);
        background: rgba(63, 63, 70, 0.5);
      }

      .dark .lang-arrow {
        color: rgba(161, 161, 170, 0.85);
      }

      .chat-thread {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        font-size: 0.66rem;
        line-height: 1.5;
      }

      .chat-row {
        padding: 0.4rem 0.6rem;
        border-radius: 0.55rem;
        max-width: 92%;
      }

      .chat-row.is-user {
        align-self: flex-end;
        background: rgba(24, 24, 27, 0.94);
        color: rgba(244, 244, 245, 0.96);
      }

      .chat-row.is-assistant {
        align-self: flex-start;
