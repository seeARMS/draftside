---
import { Font } from "astro:assets";
import PwaRegistration from "../components/PwaRegistration.astro";
import {
  authorName,
  defaultSiteUrl,
  description,
  ogImageAlt,
  ogImagePath,
  siteName,
  title,
  xHandle,
} from "../site-meta.js";
import "../styles/global.css";

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? defaultSiteUrl;
const pageUrl = `${siteUrl}/`;
const metaImage = `${siteUrl}${ogImagePath}`;
const xUrl = "https://x.com/colinarms";
const robotsContent = "index, follow, max-image-preview:large, max-snippet:-1";
const structuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
    description,
    inLanguage: "en-US",
    publisher: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: siteName,
    url: pageUrl,
    description,
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Any modern Chrome browser",
    browserRequirements: "Chrome with built-in AI availability for local Gemini Nano features",
    image: metaImage,
    isAccessibleForFree: true,
    author: {
      "@type": "Person",
      name: authorName,
      url: xUrl,
    },
    featureList: [
      "Open source",
      "Runs 100% offline in the browser",
      "On-device Chrome built-in Gemini Nano",
      "Ghost sentence completions accepted with Tab",
      "Inline alternate wording suggestions",
      "Draft classification: form, intent, stance, friction, next move",
      "Persistent local drafts in browser storage",
      "Installable as a progressive web app",
    ],
    keywords: "open source writing editor, offline AI writing, local-first writing app, Gemini Nano writing tool, Chrome built-in AI editor, on-device AI writing, private drafting tool",
  },
]);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/localwrite.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/localwrite-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="author" content={authorName} />
    <meta name="creator" content={authorName} />
    <meta name="publisher" content={authorName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image" content={metaImage} />
    <meta property="og:image:secure_url" content={metaImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={xHandle} />
    <meta name="twitter:creator" content={xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={metaImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <script type="application/ld+json" set:html={structuredData}></script>
    <PwaRegistration />

    <script is:inline>
      const root = document.documentElement;
      const darkModeMediaQuery = window.matchMedia("(prefers-color-scheme: dark)");
      const THEME_KEY = "draftside.theme";
      const THEME_TRANSITION_MS = 240;
      let themeTransitionTimeout;

      updateMode();
      darkModeMediaQuery.addEventListener("change", () => {
        if (localStorage.getItem(THEME_KEY)) return;
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      });

      function updateMode() {
        const saved = localStorage.getItem(THEME_KEY);
        const isDark = saved === "dark" || (!saved && darkModeMediaQuery.matches);
        root.classList.toggle("dark", isDark);
        root.style.colorScheme = isDark ? "dark" : "light";
      }

      function startThemeTransition() {
        root.classList.add("theme-switching");
        window.clearTimeout(themeTransitionTimeout);
        themeTransitionTimeout = window.setTimeout(() => {
          root.classList.remove("theme-switching");
        }, THEME_TRANSITION_MS);
      }

      window.toggleDarkMode = function () {
        const isDark = root.classList.contains("dark");
        localStorage.setItem(THEME_KEY, isDark ? "light" : "dark");
        startThemeTransition();
        window.requestAnimationFrame(updateMode);
      };
    </script>

    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      :root {
        font-feature-settings: "cv02", "cv03", "cv04", "cv11";
      }

      .theme-switching,
      .theme-switching *,
      .theme-switching *::before,
      .theme-switching *::after {
        transition-property: background-color, border-color, color, fill, stroke, opacity, box-shadow, transform !important;
        transition-duration: 240ms !important;
        transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1) !important;
      }

      .page-shell {
        min-height: 100svh;
        background:
          linear-gradient(180deg, rgba(250, 250, 250, 0.96), rgba(255, 255, 255, 1) 42%),
          repeating-linear-gradient(90deg, rgba(24, 24, 27, 0.04) 0, rgba(24, 24, 27, 0.04) 1px, transparent 1px, transparent 64px);
      }

      .dark .page-shell {
        background:
          linear-gradient(180deg, rgba(10, 10, 10, 0.96), rgba(20, 20, 20, 1) 44%),
          repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.045) 0, rgba(255, 255, 255, 0.045) 1px, transparent 1px, transparent 64px);
      }

      .product-field {
        position: absolute;
        inset: 5.75rem max(-3vw, -3rem) auto auto;
        width: min(58rem, 68vw);
        height: min(36rem, 60svh);
        border: 1px solid rgba(212, 212, 216, 0.78);
        border-radius: 0.85rem;
        background: rgba(255, 255, 255, 0.96);
        box-shadow:
          0 1px 2px rgba(15, 23, 42, 0.05),
          0 30px 80px rgba(15, 23, 42, 0.10);
        overflow: hidden;
      }

      .dark .product-field {
        border-color: rgba(63, 63, 70, 0.9);
        background: rgba(24, 24, 27, 0.92);
        box-shadow:
          0 1px 2px rgba(0, 0, 0, 0.32),
          0 30px 90px rgba(0, 0, 0, 0.42);
      }

      .editor-chrome {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        height: 2.35rem;
        padding: 0 1rem;
        border-bottom: 1px solid rgba(228, 228, 231, 0.78);
        font-family: var(--font-geist-mono);
        font-size: 0.7rem;
        color: rgba(113, 113, 122, 0.95);
      }

      .dark .editor-chrome {
        border-color: rgba(63, 63, 70, 0.9);
        color: rgba(161, 161, 170, 0.92);
      }

      .editor-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.18);
      }

      .editor-filename {
        flex: 1;
        letter-spacing: -0.005em;
      }

      .editor-badge {
        border-radius: 999px;
        padding: 0.18rem 0.6rem;
        background: rgba(244, 244, 245, 0.95);
        color: rgba(82, 82, 91, 0.95);
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .dark .editor-badge {
        background: rgba(63, 63, 70, 0.7);
        color: rgba(212, 212, 216, 0.92);
      }

      .draft-body {
        padding: 3rem 3.5rem 2rem;
        max-width: 38rem;
        color: rgba(24, 24, 27, 0.92);
        font-size: clamp(1rem, 1.3vw, 1.2rem);
        line-height: 1.85;
      }

      .dark .draft-body {
        color: rgba(244, 244, 245, 0.92);
      }

      .draft-body strong {
        display: block;
        margin-bottom: 1.35rem;
        font-size: 1.4em;
        font-weight: 600;
        letter-spacing: -0.022em;
      }

      .ghost-text {
        color: rgba(113, 113, 122, 0.6);
      }

      .dark .ghost-text {
        color: rgba(161, 161, 170, 0.55);
      }

      .ghost-key {
        display: inline-block;
        margin-left: 0.45em;
        padding: 0.05em 0.45em;
        border: 1px solid rgba(212, 212, 216, 0.85);
        border-bottom-width: 2px;
        border-radius: 0.3rem;
        background: rgba(244, 244, 245, 0.9);
        color: rgba(82, 82, 91, 0.92);
        font-family: var(--font-geist-mono);
        font-size: 0.62em;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        vertical-align: 0.18em;
        line-height: 1.4;
      }

      .dark .ghost-key {
        border-color: rgba(82, 82, 91, 0.9);
        background: rgba(39, 39, 42, 0.95);
        color: rgba(212, 212, 216, 0.85);
      }

      .classification {
        position: absolute;
        right: 1.5rem;
        bottom: 1.5rem;
        width: 15.5rem;
        padding: 0.95rem 1.1rem;
        border: 1px solid rgba(228, 228, 231, 0.85);
        border-radius: 0.6rem;
        background: rgba(250, 250, 251, 0.94);
        font-family: var(--font-geist-mono);
        backdrop-filter: blur(6px);
      }

      .dark .classification {
        border-color: rgba(63, 63, 70, 0.92);
        background: rgba(39, 39, 42, 0.82);
      }

      .classification dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 0.5rem 1rem;
        margin: 0;
      }

      .classification dt {
        color: rgba(113, 113, 122, 0.95);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: 0.6rem;
      }

      .dark .classification dt {
        color: rgba(161, 161, 170, 0.85);
      }

      .classification dd {
        margin: 0;
        color: rgba(39, 39, 46, 0.94);
        font-size: 0.7rem;
        letter-spacing: -0.005em;
      }

      .dark .classification dd {
        color: rgba(228, 228, 231, 0.92);
      }

      .feature-grid > div {
        border-top: 1px solid rgba(228, 228, 231, 0.88);
        padding-top: 1.35rem;
      }

      .dark .feature-grid > div {
        border-color: rgba(63, 63, 70, 0.86);
      }

      @media (max-width: 900px) {
        .product-field {
          position: relative;
          inset: auto;
          width: 100%;
          height: auto;
          margin-top: 2.5rem;
        }

        .draft-body {
          padding: 2rem 1.75rem 1.5rem;
          max-width: 100%;
          font-size: 1rem;
        }

        .classification {
          position: relative;
          right: auto;
          bottom: auto;
          width: auto;
          margin: 0 1.5rem 1.5rem;
        }

        .editor-badge {
          display: none;
        }
      }
    </style>
  </head>
  <body class="overflow-x-hidden bg-white text-zinc-900 antialiased dark:bg-[#141414] dark:text-zinc-100">
    <div class="page-shell">
      <nav class="relative z-20">
        <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 text-sm">
          <a href="/" class="inline-flex items-center gap-2 font-medium text-zinc-950 transition-opacity hover:opacity-80 dark:text-zinc-50">
            <img src="/localwrite-192.png" alt="" width="28" height="28" class="size-7 rounded-md" />
            Draftside
          </a>
          <div class="flex items-center gap-5 text-zinc-500 dark:text-zinc-400">
            <a href="/editor" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Editor</a>
            <a href="https://github.com/seeARMS/draftside" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">GitHub</a>
            <button
              type="button"
              onclick="toggleDarkMode()"
              aria-label="Toggle dark mode"
              class="relative flex h-8 w-8 items-center justify-center text-zinc-500 transition-colors duration-200 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
            >
              <svg class="absolute h-4 w-4 rotate-90 scale-0 opacity-0 transition-all duration-300 dark:rotate-0 dark:scale-100 dark:opacity-100" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
              </svg>
              <svg class="absolute h-4 w-4 rotate-0 scale-100 opacity-100 transition-all duration-300 dark:rotate-90 dark:scale-0 dark:opacity-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <main>
        <section class="relative overflow-hidden px-6 pb-14 pt-14 md:min-h-[82svh] md:pb-20 md:pt-20">
          <div class="product-field" aria-hidden="true">
            <div class="editor-chrome">
              <span class="editor-dot"></span>
              <span class="editor-filename">draftside &middot; untitled.md</span>
              <span class="editor-badge">offline &middot; on-device</span>
            </div>
            <div class="draft-body">
              <strong>Notes toward the thing I mean</strong>
              <p>
                Start with the rough version. Draftside keeps the page quiet while local AI waits at the edge of the sentence<span class="ghost-text"> and offers the next few words.</span><span class="ghost-key">tab</span>
              </p>
            </div>
            <div class="classification">
              <dl>
                <dt>form</dt><dd>notes</dd>
                <dt>intent</dt><dd>drafting</dd>
                <dt>stance</dt><dd>tentative</dd>
                <dt>friction</dt><dd>finding the thread</dd>
              </dl>
            </div>
          </div>

          <div class="relative z-10 mx-auto max-w-6xl">
            <div class="max-w-2xl">
              <p class="mb-5 font-mono text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">Open source · 100% offline · Local AI</p>
              <h1 class="text-5xl font-semibold leading-[0.98] tracking-[-0.035em] text-zinc-950 text-balance dark:text-zinc-50 sm:text-6xl md:text-7xl">
                Draftside
              </h1>
              <p class="mt-6 max-w-[38rem] text-lg leading-8 text-zinc-600 text-pretty dark:text-zinc-400">
                An open source writing editor that runs entirely in your browser. Chrome's built-in Gemini Nano powers inline completions, rewrites, alternate phrasing, and draft classification &mdash; all on your device. No account. No API key. No server.
              </p>
              <div class="mt-9 flex flex-col gap-3 sm:flex-row">
                <a href="/editor" class="inline-flex min-h-11 items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200">
                  Open the editor
                </a>
                <a href="https://github.com/seeARMS/draftside" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center justify-center rounded-lg border border-zinc-200 px-5 text-sm font-medium text-zinc-800 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-200 dark:hover:bg-zinc-900">
                  View on GitHub
                </a>
              </div>
            </div>
          </div>
        </section>

        <section id="how-it-works" class="px-6 py-16 md:py-20">
          <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[0.85fr_1.15fr] md:items-start">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-500">Why it exists</p>
              <h2 class="mt-4 max-w-md text-3xl font-semibold tracking-[-0.025em] text-zinc-950 dark:text-zinc-50 md:text-4xl">
                AI help that stays beside the draft, not above it.
              </h2>
            </div>
            <div class="feature-grid grid gap-8 sm:grid-cols-2">
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">100% offline. Always.</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Drafts live in your browser's storage. Install Draftside as a PWA and keep writing on a plane, in a tunnel, or anywhere there's no network.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">On-device Gemini Nano</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Chrome runs the model on your machine. No API keys, no rate limits, no servers. Your draft never leaves the tab.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Read your own draft</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Ask the local model to classify what you've written &mdash; its form, intent, stance, and the friction holding it back. A second mind on the page, run locally.</p>
              </div>
              <div>
                <h3 class="text-base font-semibold text-zinc-950 dark:text-zinc-50">Suggestions, not interruptions</h3>
                <p class="mt-2 leading-7 text-zinc-600 dark:text-zinc-400">Pause briefly and Draftside offers a faint continuation. Highlight a phrase to swap in alternate wording. Tab to accept, keep typing to ignore.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="px-6 pb-24 pt-6 md:pb-28">
          <div class="mx-auto max-w-6xl border-t border-zinc-200 pt-12 dark:border-zinc-800">
            <div class="max-w-2xl">
              <h2 class="text-3xl font-semibold tracking-[-0.025em] text-zinc-950 dark:text-zinc-50">Open a blank page with a useful edge.</h2>
              <p class="mt-4 text-lg leading-8 text-zinc-600 dark:text-zinc-400">
                Draftside is built for notes, essays, posts, and any draft that benefits from a second pass without leaving the writing flow. Open source, no account, runs in your browser. Open it and start typing.
              </p>
              <a href="/editor" class="mt-7 inline-flex min-h-11 items-center justify-center rounded-lg bg-zinc-950 px-5 text-sm font-medium text-white transition-colors hover:bg-zinc-800 dark:bg-zinc-50 dark:text-zinc-950 dark:hover:bg-zinc-200">
                Start drafting
              </a>
            </div>
          </div>
        </section>
      </main>

      <footer class="border-t border-zinc-200 px-6 py-8 text-sm text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <span>&copy; 2026 <a href="https://armstr.ng" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Colin Armstrong</a></span>
          <div class="flex items-center gap-6">
            <a href="/editor" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">Editor</a>
            <a href="https://github.com/seeARMS/draftside" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">GitHub</a>
            <a href={xUrl} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-zinc-950 dark:hover:text-zinc-100">@colinarms</a>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
